{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["tampermonkey"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@userscripts/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["scripts/*/src/**/*", "packages/*/src/**/*", "templates/*/src/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}
